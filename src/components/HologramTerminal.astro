---
// HologramTerminal - Reusable holographic floating terminal wrapper
// Props:
//   hologramTitle - displayed in the header bar (lowercase)
//   hologramLabel - displayed as inline comment above slot content
//   fullHeight    - when true: takes 100% height of parent, no float animation, used for split layouts
interface Props {
  hologramTitle?: string;
  hologramLabel?: string;
  fullHeight?: boolean;
}

const {
  hologramTitle = 'terminal',
  hologramLabel  = '// init()',
  fullHeight     = false,
} = Astro.props;
---

<div class={`hologram-terminal-outer${fullHeight ? ' htl-full-height' : ''}`}>
  <!-- Corner brackets -->
  <div class="htl-corner htl-tl"></div>
  <div class="htl-corner htl-tr"></div>
  <div class="htl-corner htl-bl"></div>
  <div class="htl-corner htl-br"></div>

  <!-- Top header bar -->
  <div class="htl-header">
    <span class="htl-dot htl-dot-red"></span>
    <span class="htl-dot htl-dot-yellow"></span>
    <span class="htl-dot htl-dot-green"></span>
    <span class="htl-title">{hologramTitle}</span>
    <span class="htl-badge">HOLOGRAM_v2.4</span>
  </div>

  <!-- Screen body -->
  <div class="htl-screen">
    <!-- Scanlines overlay -->
    <div class="htl-scanlines"></div>
    <!-- Hologram shimmer sweep -->
    <div class="htl-shimmer"></div>
    <!-- Flicker noise -->
    <div class="htl-flicker"></div>

    <!-- Content -->
    <div class="htl-content">
      <!-- Label -->
      <p class="htl-label">{hologramLabel}</p>

      <!-- Slot: caller provides the actual content -->
      <slot />

      <!-- Bottom status line -->
      <p class="htl-status">
        <span class="htl-cursor-blink">█</span>
        <span class="htl-status-text">SYS: IRIS_94 &nbsp;|&nbsp; STATUS: ONLINE &nbsp;|&nbsp; LOC: CODE-CITY</span>
      </p>
    </div>
  </div>

  <!-- Bottom edge glow line -->
  <div class="htl-bottom-line"></div>
</div>

<style>
  /* ── Outer wrapper ─────────────────────────────────────────────────── */
  .hologram-terminal-outer {
    position: relative;
    width: 100%;
    background: transparent;
    padding: 2px;
    box-shadow:
      0 0 0 1px rgba(45, 226, 230, 0.35),
      0 0 12px rgba(45, 226, 230, 0.25),
      0 0 40px rgba(45, 226, 230, 0.10),
      inset 0 0 60px rgba(45, 226, 230, 0.04);
    animation: hologram-float 6s ease-in-out infinite;
    border: 1px solid rgba(45, 226, 230, 0.30);
    overflow: visible;
  }

  /* fullHeight variant — fills parent container, no float */
  .htl-full-height {
    height: 100%;
    display: flex;
    flex-direction: column;
    animation: hologram-glow-pulse 4s ease-in-out infinite; /* glow only, no translateY */
  }
  .htl-full-height .htl-screen {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .htl-full-height .htl-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* ── Corner brackets ───────────────────────────────────────────────── */
  .htl-corner {
    position: absolute;
    width: 18px;
    height: 18px;
    z-index: 10;
  }
  .htl-tl { top: -2px; left: -2px;  border-top: 2px solid var(--theme-neon-cyan); border-left:  2px solid var(--theme-neon-cyan); }
  .htl-tr { top: -2px; right: -2px; border-top: 2px solid var(--theme-neon-cyan); border-right: 2px solid var(--theme-neon-cyan); }
  .htl-bl { bottom: -2px; left: -2px;  border-bottom: 2px solid var(--theme-neon-cyan); border-left:  2px solid var(--theme-neon-cyan); }
  .htl-br { bottom: -2px; right: -2px; border-bottom: 2px solid var(--theme-neon-cyan); border-right: 2px solid var(--theme-neon-cyan); }

  /* ── Header bar ────────────────────────────────────────────────────── */
  .htl-header {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    background: rgba(13, 2, 33, 0.85);
    border-bottom: 1px solid rgba(45, 226, 230, 0.20);
    font-family: 'Space Grotesk', monospace;
    flex-shrink: 0;
  }

  .htl-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }
  .htl-dot-red    { background: #FD1D53; box-shadow: 0 0 4px #FD1D53; }
  .htl-dot-yellow { background: #F9C80E; box-shadow: 0 0 4px #F9C80E; }
  .htl-dot-green  { background: #2DE2E6; box-shadow: 0 0 4px #2DE2E6; }

  .htl-title {
    font-size: clamp(9px, 1.2vw, 11px);
    color: rgba(45, 226, 230, 0.7);
    text-transform: lowercase;
    letter-spacing: 0.15em;
    margin-left: 4px;
  }

  .htl-badge {
    margin-left: auto;
    font-size: 9px;
    color: rgba(45, 226, 230, 0.4);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-family: monospace;
  }

  /* ── Screen body ───────────────────────────────────────────────────── */
  .htl-screen {
    position: relative;
    background: rgba(13, 2, 33, 0.70);
    overflow: hidden;
    padding: 24px 28px 20px;
    backdrop-filter: blur(2px);
  }

  /* Scanlines */
  .htl-scanlines {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 5;
    background:
      linear-gradient(rgba(18,16,16,0) 50%, rgba(0,0,0,0.22) 50%),
      linear-gradient(90deg, rgba(255,0,0,0.03), rgba(0,255,0,0.01), rgba(0,0,255,0.03));
    background-size: 100% 4px, 3px 100%;
    opacity: 0.5;
  }

  /* Hologram shimmer sweep */
  .htl-shimmer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 4;
    background: linear-gradient(
      105deg,
      transparent 40%,
      rgba(45, 226, 230, 0.06) 50%,
      transparent 60%
    );
    background-size: 200% 100%;
    animation: hologram-sweep 4s ease-in-out infinite;
  }

  /* Flicker overlay */
  .htl-flicker {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 6;
    background: rgba(45, 226, 230, 0.025);
    animation: hologram-flicker 0.12s steps(1) infinite;
    opacity: 0;
  }

  /* ── Content ───────────────────────────────────────────────────────── */
  .htl-content {
    position: relative;
    z-index: 10;
  }

  .htl-label {
    font-family: 'Space Grotesk', monospace;
    font-size: clamp(9px, 1.1vw, 11px);
    color: rgba(45, 226, 230, 0.45);
    letter-spacing: 0.15em;
    text-transform: lowercase;
    margin-bottom: 16px;
    margin-left: 2px;
  }

  /* ── Status bar ────────────────────────────────────────────────────── */
  .htl-status {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: monospace;
    font-size: clamp(8px, 1vw, 10px);
    color: rgba(45, 226, 230, 0.40);
    letter-spacing: 0.12em;
    border-top: 1px solid rgba(45, 226, 230, 0.10);
    padding-top: 10px;
    margin-top: 20px;
  }

  .htl-cursor-blink {
    color: var(--theme-neon-cyan);
    animation: htl-cursor-pulse 1s steps(1) infinite;
    font-size: 10px;
    opacity: 0.8;
  }

  /* ── Bottom accent line ─────────────────────────────────────────────── */
  .htl-bottom-line {
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(45, 226, 230, 0.6) 20%,
      rgba(45, 226, 230, 0.9) 50%,
      rgba(45, 226, 230, 0.6) 80%,
      transparent
    );
    box-shadow: 0 0 10px rgba(45, 226, 230, 0.5);
    animation: hologram-line-pulse 3s ease-in-out infinite;
    flex-shrink: 0;
  }

  /* ── Mobile: more compact, slightly taller padding ──────────────────── */
  @media (max-width: 640px) {
    .htl-screen {
      padding: 16px 14px 14px;
    }
    .htl-header {
      padding: 5px 10px;
    }
    .htl-badge {
      display: none; /* save horizontal space */
    }
  }

  /* ── Keyframes ──────────────────────────────────────────────────────── */
  @keyframes hologram-float {
    0%, 100% { transform: translateY(0px);  box-shadow: 0 0 0 1px rgba(45,226,230,0.35), 0 0 12px rgba(45,226,230,0.25), 0 0 40px rgba(45,226,230,0.10), inset 0 0 60px rgba(45,226,230,0.04); }
    50%       { transform: translateY(-4px); box-shadow: 0 0 0 1px rgba(45,226,230,0.50), 0 0 18px rgba(45,226,230,0.35), 0 0 55px rgba(45,226,230,0.15), inset 0 0 60px rgba(45,226,230,0.07); }
  }

  @keyframes hologram-glow-pulse {
    0%, 100% { box-shadow: 0 0 0 1px rgba(45,226,230,0.35), 0 0 12px rgba(45,226,230,0.25), 0 0 40px rgba(45,226,230,0.10), inset 0 0 60px rgba(45,226,230,0.04); }
    50%       { box-shadow: 0 0 0 1px rgba(45,226,230,0.55), 0 0 20px rgba(45,226,230,0.40), 0 0 60px rgba(45,226,230,0.18), inset 0 0 60px rgba(45,226,230,0.08); }
  }

  @keyframes hologram-sweep {
    0%   { background-position: 200% 0; opacity: 0; }
    10%  { opacity: 1; }
    90%  { opacity: 1; }
    100% { background-position: -200% 0; opacity: 0; }
  }

  @keyframes hologram-flicker {
    0%  { opacity: 0; }
    92% { opacity: 0; }
    93% { opacity: 1; }
    95% { opacity: 0; }
    97% { opacity: 1; }
    99% { opacity: 0; }
  }

  @keyframes hologram-line-pulse {
    0%, 100% { opacity: 0.6; }
    50%       { opacity: 1; }
  }

  @keyframes htl-cursor-pulse {
    0%, 49%   { opacity: 0.8; }
    50%, 100% { opacity: 0; }
  }
</style>
