---

interface Props {
  rotate?: boolean;
  sysId?: string;
}

const { rotate = false, sysId = "IRIS_94" } = Astro.props;
---

<div
  class="cdpad-outer relative w-full max-w-xs mx-auto"
  data-rotate={rotate ? "true" : "false"}
>

  <div class="cdpad-top-edge">
    <span class="cdp-led cdp-led-red"></span>
    <span class="cdp-led cdp-led-amber"></span>
    <div class="cdpad-camera-slot"></div>
    <span class="cdp-led cdp-led-green"></span>
    <span class="cdp-label">IRIS_94</span>
  </div>

  <div class="cdpad-label-strip">
    <span>CYBERDECK // DATAPAD_v1</span>
    <span class="cdp-status-active">COMPILER: ACTIVE</span>
  </div>

  <div class="cdpad-bezel">

    <div class="cdp-scanlines"></div>
    
    <div class="cdp-shimmer"></div>

    <div class="cdpad-screen-bar">
      <span class="opacity-60 text-[9px]">{sysId} :~$</span>
      <span class="flex items-center gap-1 ml-auto">
        <span class="cdp-status-pill">BIOMETRIC: OK</span>
        <span class="cdp-pulse-dot"></span>
      </span>
    </div>

    <div class="cdpad-content">
      <slot />
    </div>

    <div class="cdpad-hex-bar" id="cdpad-hex-bar">
      
    </div>

  </div>

  <div class="cdpad-footer">
    <div class="cdp-connector"></div>
    <div class="cdp-connector cdp-conn-wide"></div>
    <div class="cdp-connector"></div>
  </div>

</div>

<style>
  
  .cdpad-outer {
    background: #0a0812;
    border: 1px solid #2a2040;
    box-shadow:
      0 0 0 1px #1a1030,
      0 0 20px rgba(45,226,230,0.07),
      0 20px 40px rgba(0,0,0,0.9);
    transition: transform 0.1s ease-out;
  }

  .cdpad-top-edge {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 7px 12px;
    background: #06040f;
    border-bottom: 1px solid #2a2040;
  }
  .cdp-led {
    display: inline-block;
    width: 6px; height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .cdp-led-red   { background: #FD1D53; box-shadow: 0 0 4px #FD1D53; }
  .cdp-led-amber { background: #F9C80E; box-shadow: 0 0 4px #F9C80E; }
  .cdp-led-green { background: #2DE2E6; box-shadow: 0 0 4px #2DE2E6; animation: cdp-blink 2s steps(1) infinite; }
  .cdpad-camera-slot {
    flex: 1;
    height: 3px;
    background: #111;
    border: 1px solid #1e1e2e;
    border-radius: 2px;
  }
  .cdp-label {
    font-family: monospace;
    font-size: 7px;
    color: rgba(45,226,230,0.4);
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .cdpad-label-strip {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 3px 12px;
    background: #080614;
    border-bottom: 1px solid #1a1030;
    font-family: monospace;
    font-size: 7px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(45,226,230,0.3);
  }
  .cdp-status-active {
    color: rgba(249,200,14,0.6);
    animation: cdp-flicker 3s steps(1) infinite;
  }

  .cdpad-bezel {
    background: #241734;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: 340px;
  }
  .cdp-scanlines {
    position: absolute; inset: 0;
    pointer-events: none; z-index: 5;
    background:
      linear-gradient(rgba(18,16,16,0) 50%, rgba(0,0,0,0.25) 50%),
      linear-gradient(90deg,rgba(255,0,0,0.06),rgba(0,255,0,0.02),rgba(0,0,255,0.06));
    background-size: 100% 4px, 3px 100%;
    opacity: 0.4;
  }
  .cdp-shimmer {
    position: absolute; inset: 0;
    pointer-events: none; z-index: 4;
    background: linear-gradient(105deg, transparent 40%, rgba(45,226,230,0.04) 50%, transparent 60%);
    background-size: 200% 100%;
    animation: cdp-sweep 5s ease-in-out infinite;
  }

  .cdpad-screen-bar {
    display: flex;
    align-items: center;
    padding: 0 12px;
    height: 22px;
    background: rgba(0,0,0,0.5);
    border-bottom: 1px solid rgba(0,0,0,0.6);
    font-family: monospace;
    color: var(--theme-neon-cyan);
    position: relative; z-index: 40;
    flex-shrink: 0;
  }
  .cdp-status-pill {
    font-size: 6px;
    padding: 1px 5px;
    border: 1px solid rgba(45,226,230,0.3);
    color: rgba(45,226,230,0.6);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .cdp-pulse-dot {
    display: inline-block;
    width: 6px; height: 6px;
    background: var(--theme-neon-cyan);
    animation: cdp-blink 1s steps(1) infinite;
  }

  .cdpad-content {
    flex: 1;
    padding: 16px 14px;
    font-family: 'Space Grotesk', monospace;
    color: var(--theme-neon-cyan);
    font-size: 0.8rem;
    position: relative; z-index: 40;
    overflow-y: auto;
  }
  .cdpad-content::-webkit-scrollbar { width: 3px; }
  .cdpad-content::-webkit-scrollbar-track { background: rgba(0,0,0,0.2); }
  .cdpad-content::-webkit-scrollbar-thumb { background: var(--theme-neon-cyan); }

  .cdpad-hex-bar {
    height: 20px;
    background: #06040f;
    border-top: 1px solid #1a1030;
    font-family: monospace;
    font-size: 7px;
    color: rgba(45,226,230,0.2);
    padding: 3px 10px;
    overflow: hidden;
    white-space: nowrap;
    position: relative; z-index: 40;
    flex-shrink: 0;
  }

  .cdpad-footer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 6px 16px;
    background: #06040f;
    border-top: 1px solid #2a2040;
  }
  .cdp-connector {
    width: 14px; height: 8px;
    background: #111;
    border: 1px solid #2a2040;
    border-radius: 1px;
  }
  .cdp-conn-wide { width: 28px; }

  @keyframes cdp-blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0.15; }
  }
  @keyframes cdp-flicker {
    0%, 88% { opacity: 1; }
    89%, 90% { opacity: 0.1; }
    91%, 100% { opacity: 1; }
  }
  @keyframes cdp-sweep {
    0%   { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }
</style>

<script>

  const hexBar = document.getElementById('cdpad-hex-bar');
  if (hexBar) {
    const chars = '0123456789ABCDEF ';
    const fill = () => Array.from({ length: 60 }, () =>
      chars[Math.floor(Math.random() * chars.length)]
    ).join('');
    hexBar.textContent = fill();
    setInterval(() => { hexBar.textContent = fill(); }, 300);
  }

  const pads = document.querySelectorAll('.cdpad-outer[data-rotate="true"]');
  pads.forEach((pad) => {
    const el = pad as HTMLElement;
    el.addEventListener('mousemove', (e) => {
      const ev = e as MouseEvent;
      const rect = el.getBoundingClientRect();
      const rx = ((ev.clientY - rect.top  - rect.height / 2) / (rect.height / 2)) * -5;
      const ry = ((ev.clientX - rect.left - rect.width  / 2) / (rect.width  / 2)) *  5;
      el.style.transform = `perspective(1000px) rotateX(${rx}deg) rotateY(${ry}deg)`;
    });
    el.addEventListener('mouseleave', () => {
      el.style.transition = 'transform 0.5s ease-out';
      el.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg)';
    });
    el.addEventListener('mouseenter', () => {
      el.style.transition = 'transform 0.1s ease-out';
    });
  });
</script>
