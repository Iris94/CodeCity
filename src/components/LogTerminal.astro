---
interface Props {
	rotate?: boolean;
	sysId?: string;
	label?: string;
}

const { rotate = false, sysId = "LOG_ID: SYS_LOG", label = "DATA_FRAGMENT" } = Astro.props;
---

<div
	class="log-terminal-wrapper relative w-full max-w-135 mx-auto flex flex-col transition-transform duration-100 ease-out bg-[#2f1f44] border border-[#443063] shadow-[0_24px_60px_rgba(0,0,0,0.95)]"
	data-rotate={rotate ? "true" : "false"}
>
	
	<!-- Top Bar -->
	<div class="w-full h-8 bg-black/60 flex justify-between items-center px-4 text-[9px] text-(--theme-neon-red) font-mono z-40 border-b border-black/80 flex-none select-none">
		<div class="flex items-center gap-2">
			<span class="w-1.5 h-1.5 bg-(--theme-neon-red) animate-pulse rounded-full"></span>
			<span>{label}</span>
		</div>
		<span class="opacity-60">{sysId}</span>
	</div>

	<!-- Screen Content Area -->
	<div class="relative flex-1 bg-[#241734]/95 p-6 flex flex-col min-h-60">
		<!-- CRT Scanlines overlay -->
		<div class="absolute inset-0 pointer-events-none z-50 bg-[linear-gradient(rgba(18,16,16,0)_50%,rgba(0,0,0,0.25)_50%),linear-gradient(90deg,rgba(255,0,0,0.06),rgba(0,255,0,0.02),rgba(0,0,255,0.06))] bg-size-[100%_4px,3px_100%] opacity-40"></div>

		<!-- Slot content -->
		<div class="grow z-40 flex flex-col justify-between h-full">
			<slot />
		</div>
	</div>

	<!-- Bottom status bar -->
	<div class="w-full h-5 bg-black/30 border-t border-[#1a1a2a]/60 px-4 flex justify-between items-center text-[7px] text-(--theme-text-base) font-mono opacity-50 select-none">
		<span>SECURE_CONNECTION</span>
		<span>SYS_OK</span>
	</div>

	<!-- Neon Corners -->
	<div class="absolute top-0 left-0 w-3 h-3 border-t-2 border-l-2 border-(--theme-neon-cyan) opacity-60"></div>
	<div class="absolute top-0 right-0 w-3 h-3 border-t-2 border-r-2 border-(--theme-neon-cyan) opacity-60"></div>
	<div class="absolute bottom-0 left-0 w-3 h-3 border-b-2 border-l-2 border-(--theme-neon-cyan) opacity-60"></div>
	<div class="absolute bottom-0 right-0 w-3 h-3 border-b-2 border-r-2 border-(--theme-neon-cyan) opacity-60"></div>
</div>

<script>
	function initLogTerminal() {
		const panels = document.querySelectorAll('.log-terminal-wrapper[data-rotate="true"]');

		panels.forEach((panel) => {
			const el = panel as HTMLElement;
			el.addEventListener('mousemove', (e) => {
				const ev = e as MouseEvent;
				const rect = el.getBoundingClientRect();
				const rotateX = ((ev.clientY - rect.top - rect.height / 2) / (rect.height / 2)) * -4;
				const rotateY = ((ev.clientX - rect.left - rect.width / 2) / (rect.width / 2)) * 4;
				el.style.transform = `perspective(1200px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
			});
			el.addEventListener('mouseleave', () => {
				el.style.transition = 'transform 0.5s ease-out';
				el.style.transform = 'perspective(1200px) rotateX(0deg) rotateY(0deg)';
			});
			el.addEventListener('mouseenter', () => {
				el.style.transition = 'transform 0.1s ease-out';
			});
		});
	}

	document.addEventListener('astro:page-load', initLogTerminal);
</script>
