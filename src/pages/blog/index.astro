---
import Layout from '../../layouts/Layout.astro';
import GlitchText from '../../components/GlitchText.astro';
import Navigation from '../../components/Navigation.astro';
import LogTerminal from '../../components/LogTerminal.astro';

import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

const posts = await getCollection('blog');
posts.sort((a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Iris94 — Data Logs" description="Personal data logs and development articles.">
	<Navigation />
	<main class="w-full min-h-screen pt-24 pb-16 bg-(--theme-midnight-black) relative z-10">
		<section class="w-full py-12 relative">
			<div class="w-full lg:w-10/12 max-w-270 mx-auto px-6 lg:px-0 relative z-10">
				
				<span class="block text-[10px] font-mono text-(--theme-neon-red) tracking-widest uppercase mb-3 opacity-70">
					// data_logs
				</span>

				<div class="border-t border-(--theme-neon-red) pt-14 mb-16">
					<GlitchText
						tag="h1"
						text="SYS_LOGS"
						delay={500}
						class="text-5xl sm:text-7xl text-(--theme-text-base) mb-6 text-left tracking-widest uppercase font-black font-mono"
					/>
					<p class="text-(--theme-text-base) font-mono max-w-2xl text-lg opacity-80 leading-relaxed">
						Archived development logs, architectural experiments, and field notes.
					</p>
				</div>

				<div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
					{posts.map((post: CollectionEntry<'blog'>) => (
						<LogTerminal rotate={true} sysId={`LOG_ID: ${post.id.toUpperCase()}`} label="SYS_LOG">
							<div class="flex flex-col h-full justify-between gap-6">
								<div>
									<h2 class="text-2xl font-black font-mono text-(--theme-neon-red) mb-3 uppercase tracking-wider">
										<a href={`/blog/${post.id}`} class="hover:text-(--theme-neon-cyan) transition-colors duration-300">
											{post.data.title}
										</a>
									</h2>
									<p class="text-sm font-mono text-(--theme-text-base) opacity-70 mb-4">
										{post.data.pubDate.toLocaleDateString('en-US', {
											year: 'numeric',
											month: 'long',
											day: 'numeric',
											})} // BY {post.data.author.toUpperCase()}
									</p>
									<p class="text-(--theme-text-base) font-mono text-sm leading-relaxed opacity-90">
										{post.data.description}
									</p>
								</div>
								
								<div class="flex gap-2 flex-wrap">
									{post.data.tags.map((tag: string) => (
										<span class="px-2 py-1 text-[10px] uppercase tracking-widest font-mono text-(--theme-midnight-black) bg-(--theme-neon-cyan) font-bold">
											{tag}
										</span>
									))}
								</div>
								
								<div class="mt-4 pt-4 border-t border-[#333] flex justify-end">
									<a href={`/blog/${post.id}`} class="text-(--theme-neon-red) hover:text-(--theme-neon-cyan) font-mono text-xs tracking-widest uppercase flex items-center gap-2 transition-colors">
										[ READ_LOG ] <span class="animate-pulse">_</span>
									</a>
								</div>
							</div>
						</LogTerminal>
					))}
				</div>

			</div>
		</section>
	</main>
</Layout>
