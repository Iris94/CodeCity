---

import { Play, Pause } from '@lucide/astro';
---

<div class="nav-wrapper fixed top-0 left-0 right-0 z-50 flex justify-center pt-2 sm:pt-4 px-2 sm:px-4">
  <nav class="nav-panel relative w-full max-w-270 px-1.5 pb-1.5 pt-1.5 sm:pt-5 bg-[#0a0a10] border border-[#1a1a2e] shadow-[0_0_30px_rgba(253,29,83,0.15)]">

    <div class="hidden sm:flex absolute top-0 left-0 right-0 h-4 bg-[#050508] items-center justify-between px-3 border-b border-[#1a1a2e]">
      <span class="text-[8px] font-mono text-[#FD1D53] opacity-60 tracking-widest">NAV_SYS v2.4.1</span>
      <span class="flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 bg-[#FD1D53] animate-pulse"></span>
        <span class="text-[8px] font-mono text-[#FD1D53] opacity-60">ACTIVE</span>
      </span>
    </div>

    <div class="absolute inset-0 pointer-events-none bg-[linear-gradient(rgba(18,16,16,0)_50%,rgba(0,0,0,0.15)_50%)] bg-size-[100%_3px] opacity-30"></div>

    <div class="relative flex justify-between items-center w-full px-2 sm:px-4 py-1.5 gap-3 sm:gap-6">

      <div class="flex items-center gap-3 sm:gap-6 min-w-0">
        <a href="/" class="text-(--theme-neon-cyan) text-lg sm:text-xl hover:text-(--theme-text-base) transition-colors uppercase font-bold font-mono tracking-widest shrink-0">
          IRIS_94
        </a>

        <button
          id="radio-btn"
          class="flex items-center gap-2 text-(--theme-text-base) hover:text-(--theme-neon-cyan) hover:scale-105 hover:drop-shadow-[0_0_8px_rgba(45,226,230,0.5)] transition-all duration-300 font-mono text-xs tracking-widest group shrink-0"
          aria-label="Toggle Synth Radio"
        >
          
          <span id="radio-icon-play">
            <Play size={16} />
          </span>
          
          <span id="radio-icon-pause" class="hidden">
            <Pause size={16} />
          </span>

          <span id="radio-label" class="hidden sm:inline">Play background music</span>
          
          <span id="radio-song" class="text-(--theme-neon-cyan) hidden truncate max-w-45 sm:max-w-65"></span>
        </button>
      </div>

      <ul class="flex items-center gap-3 sm:gap-10 text-(--theme-neon-red) font-mono text-[10px] sm:text-sm tracking-widest shrink-0">
        <li>
          <a href="/cases" class="hover:text-(--theme-neon-cyan) transition-colors duration-300 uppercase">[Cases]</a>
        </li>
        <li>
          <a href="/blog" class="hover:text-(--theme-neon-cyan) transition-colors duration-300 uppercase">[Blog]</a>
        </li>
      </ul>
    </div>

    <div class="absolute bottom-0 left-0 w-3 h-3 border-b-2 border-l-2 border-(--theme-neon-red)"></div>
    <div class="absolute bottom-0 right-0 w-3 h-3 border-b-2 border-r-2 border-(--theme-neon-red)"></div>
  </nav>
</div>

<audio id="radio-audio" src="https://stream.nightride.fm/nightride.mp3" preload="none" style="display:none;"></audio>

<script>
  const audio = document.getElementById('radio-audio') as HTMLAudioElement;
  const btn = document.getElementById('radio-btn') as HTMLButtonElement;
  const iconPlay = document.getElementById('radio-icon-play') as HTMLElement;
  const iconPause = document.getElementById('radio-icon-pause') as HTMLElement;
  const labelEl = document.getElementById('radio-label') as HTMLSpanElement;
  const songEl = document.getElementById('radio-song') as HTMLSpanElement;

  let playing = false;
  let eventSource: EventSource | null = null;

  audio.volume = 0.15;

  function startMetadata() {
    if (eventSource) return;
    eventSource = new EventSource('https://nightride.fm/meta');
    eventSource.onmessage = (event) => {
      if (event.data === 'keepalive') return;
      try {
        const data = JSON.parse(event.data);
        const station = data.find((d: any) => d.station === 'nightride');
        if (station) {
          const title = `${station.title} — ${station.artist}`;
          songEl.textContent = title;
        }
      } catch {}
    };
  }

  function stopMetadata() {
    if (eventSource) {
      eventSource.close();
      eventSource = null;
    }
    songEl.textContent = '';
  }

  btn.addEventListener('click', async () => {
    if (!playing) {

      try {
        await audio.play();
        playing = true;
        iconPlay.classList.add('hidden');
        iconPause.classList.remove('hidden');
        labelEl.classList.add('hidden');
        songEl.classList.remove('hidden');
        startMetadata();
      } catch (e) {
        console.error('Audio play failed', e);
      }
    } else {

      audio.pause();
      playing = false;
      iconPlay.classList.remove('hidden');
      iconPause.classList.add('hidden');
      labelEl.classList.remove('hidden');
      songEl.classList.add('hidden');
      stopMetadata();
    }
  });
</script>
